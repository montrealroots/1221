# SLATE — the environment the smoke test and the deploy need.
#
# Copy to .env and fill in. Nothing here is read by the game itself: the
# browser talks to Base44 through a signed-in session, not through a key in a
# bundle. These two are for the command line only.
#
# Never commit a filled-in copy. .env is git-ignored.

# The URL of your deployed Base44 app, no trailing slash.
#   Base44 dashboard -> your app -> the address it is served at.
SLATE_BASE44_URL=

# A token for a signed-in user, used only by tools/base44-smoke.mjs.
#   Sign in to the deployed app, open the browser devtools, and copy the
#   bearer token the app sends with a request. It is a user token, not an
#   admin key: the smoke test should prove what a player can do, not more.
SLATE_BASE44_TOKEN=

# Optional. The smoke test's built-in fixture claims this schema version.
# Leave unset unless you are testing a version bump.
# SLATE_SCHEMA_VERSION=42
