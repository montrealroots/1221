 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/engine/systems/projobs.ts b/src/engine/systems/projobs.ts
index 7966efa2..b6ce113c 100644
--- a/src/engine/systems/projobs.ts
+++ b/src/engine/systems/projobs.ts
