st3-floor: killed (ST3-R (d), o.ST3R.verdict.d.met = false)
st3-twice: killed (ST3-R (d), o.ST3R.verdict.d.met = false)
st3-segments-twice: killed (ST3-R (d), o.ST3R.verdict.d.met = false)
st3-leans: killed (ST3-R (b), o.ST3R.verdict.b.met = false)
st3-drain: killed (ST3-R (b), o.ST3R.verdict.b.met = false)
st3-grain-leak: killed (ST3-R (a), o.ST3R.verdict.a.met = false)
st6-no-draws: SURVIVED (ST6-R (b), o.ST6R.verdict.b.met = true)
st6-least: killed (ST6-R (a) or (c), o.ST6R.verdict.a.met && o.ST6R.verdict.c.met = false)
st6-no-grain: killed (ST6-R (c) or (d), o.ST6R.verdict.c.met && o.ST6R.verdict.d.met = false)
st6-no-draws-proposed: killed (ST6-R (b′), proposed and not counted, o.ST6R.proposedB.met = false)
h4-tenth: killed (H4-R (a) or (b), for the ability cut, o.h4r.abilities.listening.own.n >= 5 && Object.keys(o.h4r.abilities.listening.own.kinds).length >= 2 && o.h4r.abilities.listening.own.ahead >= 0.6 * o.h4r.abilities.listening.own.n && o.h4r.abilities.listening.own.median >= 0.3 = false)
h4-budget: killed (H4-R budgets, Object.values(o.h4r.budgets.specialists).every((b) => Math.abs(b - o.h4r.budgets.even) < 1e-9) = false)
h4-drain-back: killed (H4-R (a) and (b), stamina, o.h4r.abilities.stamina.own.n >= 5 && Object.keys(o.h4r.abilities.stamina.own.kinds).length >= 2 && o.h4r.abilities.stamina.own.ahead >= 0.6 * o.h4r.abilities.stamina.own.n && o.h4r.abilities.stamina.own.median >= 0.3 = false)
h4-no-part-text: killed (H4-R (a), memory, o.h4r.abilities.memory.own.n >= 5 && Object.keys(o.h4r.abilities.memory.own.kinds).length >= 2 && o.h4r.abilities.memory.own.ahead >= 0.6 * o.h4r.abilities.memory.own.n && o.h4r.abilities.memory.own.median >= 0.3 = false)
h4-no-night-stakes: killed (H4-R (a), composure, o.h4r.abilities.composure.own.n >= 5 && Object.keys(o.h4r.abilities.composure.own.kinds).length >= 2 && o.h4r.abilities.composure.own.ahead >= 0.6 * o.h4r.abilities.composure.own.n && o.h4r.abilities.composure.own.median >= 0.3 = false)
