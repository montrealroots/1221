node_modules
dist
.DS_Store
*.local
.env
.env.*
!.env.example
coverage
.vite

# Screenshots produced by tools/screenshot.mjs, tools/ui-audit.mjs,
# tools/text-caps.mjs and tools/walkthrough.mjs. Regenerable from the tools, so they are not carried
# in the repository.
walkthrough/
screenshots/
ui-audit/
text-caps/

# Throwaway measurement scripts. A probe has to sit inside the repository for
# vite-node to resolve `@/engine` and for playwright to find its browser, so the
# only place to write one is here — and none of them is worth carrying, because
# every figure a probe produces is meant to end up in a doc, a comment or a test
# rather than in the script that found it.
probe/

# Pull caches (rebuildable from Wikidata; large)
tools/filmography/cache/
tools/people/cache/
shots/
shots-company/
shots-tour/
shots-scene/
shots-dealer/
shots-date/

# Worktrees the agent harness checks out while a workflow is running. They are
# whole copies of this repository, they are locked while their agent is alive,
# and they are gone when it finishes — so they are infrastructure, not content.
.claude/worktrees/
